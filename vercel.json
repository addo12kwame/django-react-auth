{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix react_auth run build",
  "installCommand": "npm --prefix react_auth ci",
  "outputDirectory": "react_auth/dist",
  "regions": [
    "iad1"
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
